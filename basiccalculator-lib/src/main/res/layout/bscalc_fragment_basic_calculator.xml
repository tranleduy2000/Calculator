<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/bscalc_basic_calculator_dialog_width"
    android:layout_height="@dimen/bscalc_basic_calculator_dialog_height"
    android:background="?colorSurface"
    android:orientation="vertical"
    android:weightSum="3">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/display"
            layout="@layout/bscalc_display" />
    </FrameLayout>


    <com.xlythe.calculator.material.view.CalculatorPadView
        android:id="@+id/pad_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:overScrollMode="never"
        tools:background="#FFFAAA">

        <LinearLayout
            android:id="@+id/base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:weightSum="4"
            tools:ignore="RtlHardcoded">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                tools:ignore="NestedWeights">

                <include layout="@layout/bscalc_pad_numeric" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <include layout="@layout/bscalc_pad_operator_one_col" />
            </FrameLayout>

        </LinearLayout>

        <com.xlythe.calculator.material.view.SolidLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:alpha="0.5"
            tools:visibility="gone">

            <include
                android:id="@+id/pad_advanced"
                layout="@layout/bscalc_pad_advanced" />

        </com.xlythe.calculator.material.view.SolidLayout>

    </com.xlythe.calculator.material.view.CalculatorPadView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <!-- Confirm bar: shows the value that will be returned and the button that returns it.
         It sits at the bottom of the dialog, right under the keypad, so it is close to the
         keys the user has just been pressing. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/confirm_result_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:typeface="monospace"
            tools:text="123123123123" />

        <!-- Icon + label, so the action is readable and not only a check mark. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/bscalc_button_done"
            app:icon="@drawable/bscalc_round_done_outline_24" />
    </LinearLayout>

</LinearLayout>
